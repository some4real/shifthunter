{% load static %}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ShiftHunter · Operations console</title><link rel="stylesheet" href="{% static 'shifthunter/dashboard.css' %}"></head><body><header><div class="brand"><div class="mark">✦</div><div><b>SHIFTHUNTER</b><span>OPERATIONS CONSOLE</span></div></div><div class="top"><span id="connection"><i></i> Preview mode</span><button aria-label="Notifications">♢</button><strong>JD</strong></div></header><main><div class="intro"><div><div class="eyebrow">◉ MONITORING ACTIVE</div><h1>Available shifts</h1><p>Live visibility into shifts that match your preferences. Priority matches rise to the top automatically.</p></div><button id="refresh" class="primary">↻ <span>Refresh shifts</span></button></div><div class="metrics"><div><label>Available now</label><strong id="available">4</strong><small>unassigned shifts</small></div><div><label>Primary matches</label><strong id="primary">2</strong><small>DHS - 151 East</small></div><div><label>Potential pay</label><strong id="pay">$551.79</strong><small>across visible shifts</small></div><div><label>Last API check</label><strong id="checked">Checking…</strong><small id="detail">waiting for response</small></div></div><div id="error" class="error" hidden></div><section><div class="toolbar"><label class="search">⌕<input id="query" placeholder="Search locations" aria-label="Search locations"></label><select id="site" aria-label="Filter by site"><option>All sites</option></select><button id="auto">▣ Autoassignable</button><button aria-label="View settings">☷</button></div><div class="columns"><span>Location</span><span>Schedule</span><span>Window</span><span>Distance</span><span>Est. pay</span><span>Status</span></div><div id="rows"></div><footer><span>Read-only monitoring · No schedule changes are made</span><span>Times shown in Eastern Time</span></footer></section></main><script src="{% static 'shifthunter/dashboard.js' %}"></script></body></html>
